        "faq13": {
          "type": "faq",
          "settings": {
            "question": "When will my order arrive?",
            "answer": "<p>Every piece is made to order, just for you — please allow five working days for us to make it and send it out. All the details are in our <a href=\"/policies/shipping-policy\" title=\"Shipping policy\">shipping policy</a>.</p>"
          }
        },
        "faq14": {
          "type": "faq",
          "settings": {
            "question": "Can I return or exchange something?",
            "answer": "<p>Yes. You have 30 days to request a return on unworn items with their tags, in the original packaging. Sale and discounted items have 14 days and are exchange only. Read the full <a href=\"/policies/refund-policy\" title=\"Refund policy\">refund policy</a>.</p>"
          }
        },
        "faq15": {
          "type": "faq",
          "settings": {
            "question": "Do you ship to Europe?",
            "answer": "<p>Yes. On EU orders under €150 we pay all the taxes for you; over €150, taxes are payable on delivery. EU customers also get a 14-day cooling-off period.</p>"
          }
        },
        "faq16": {
          "type": "faq",
          "settings": {
            "question": "Can I stock Dready or work with you?",
            "answer": "<p>We’d love to hear from you. Pick <strong>Wholesale</strong> or <strong>Collabs</strong> above, or email Victoria directly at <a href=\"mailto:victoria@dreadyoriginal.com\" title=\"Email Victoria\">victoria@dreadyoriginal.com</a>.</p>"
          }
        },
        "faq17": {
          "type": "faq",
          "settings": {
            "question": "How do I get 10% off my first order?",
            "answer": "<p>Join the family at the bottom of this page and your 10% welcome code lands in your inbox.</p>"
          }
        }
      },
