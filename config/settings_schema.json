[
  {
    "name": "theme_info",
    "theme_name": "Dready Original",
    "theme_version": "1.0.0",
    "theme_author": "Dready Original",
    "theme_documentation_url": "https://github.com/",
    "theme_support_url": "https://dreadyoriginal.com/pages/contact-us"
  },
  {
    "name": "Brand",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo (header)",
        "info": "Transparent PNG or SVG. Shown at the height set below."
      },
      {
        "type": "range",
        "id": "logo_height",
        "min": 28,
        "max": 64,
        "step": 2,
        "unit": "px",
        "label": "Logo height",
        "default": 44
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "32 x 32px .png recommended"
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent (Rasta gold)",
        "default": "#f8c010",
        "info": "Used sparingly: sale/new badges, accent buttons, culture sections."
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "min": 1200,
        "max": 1800,
        "step": 50,
        "unit": "px",
        "label": "Max page width",
        "default": 1600
      }
    ]
  },
  {
    "name": "Product cards",
    "settings": [
      {
        "type": "checkbox",
        "id": "card_hover_swap",
        "label": "Swap to second image on hover",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_quick_add",
        "label": "Show sizes on card (quick add)",
        "default": true,
        "info": "Daily Paper style: size buttons appear on the card and add straight to the basket."
      },
      {
        "type": "checkbox",
        "id": "card_show_vendor",
        "label": "Show vendor",
        "default": false
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart type",
        "options": [
          { "value": "drawer", "label": "Drawer" },
          { "value": "page", "label": "Page" }
        ],
        "default": "drawer"
      },
      {
        "type": "text",
        "id": "cart_note",
        "label": "Cart drawer note",
        "default": "Embroidered items are made to order — please allow 5 working days."
      }
    ]
  },
  {
    "name": "Social",
    "settings": [
      { "type": "url", "id": "social_instagram", "label": "Instagram" },
      { "type": "url", "id": "social_facebook", "label": "Facebook" },
      { "type": "url", "id": "social_twitter", "label": "X / Twitter" },
      { "type": "url", "id": "social_tiktok", "label": "TikTok" },
      { "type": "url", "id": "social_youtube", "label": "YouTube" },
      { "type": "url", "id": "social_spotify", "label": "Spotify" },
      { "type": "url", "id": "social_bandcamp", "label": "Bandcamp" }
    ]
  }
]
