{%- comment -%}
  Product card — Daily Paper pattern.
  - 4:5 packshot, swaps to 2nd image on hover (swipe on touch)
  - Size buttons on the card → quick add straight to basket
  - Colour-in-title style, clean price, badges (Sale / New / Premium / 18+)
  Params: product (required), lazy (bool), sizes_position ('overlay'|'below'), show_quick_add (bool override)
{%- endcomment -%}
{%- liquid
  assign img1 = product.featured_media
  assign img2 = nil
  if product.media.size > 1 and settings.card_hover_swap
    assign img2 = product.media[1]
  endif
  assign on_sale = false
  if product.compare_at_price > product.price
    assign on_sale = true
  endif
  assign is_new = false
  if product.tags contains 'new' or product.tags contains 'New'
    assign is_new = true
  endif
  assign is_premium = false
  if product.tags contains 'premium' or product.tags contains 'Premium'
    assign is_premium = true
  endif
  assign is_adult = false
  if product.tags contains '18+' or product.tags contains 'adult' or product.tags contains 'smoking'
    assign is_adult = true
  endif
  assign quick_add = settings.card_quick_add
  if show_quick_add != nil
    assign quick_add = show_quick_add
  endif
  assign size_option_index = nil
  for opt in product.options_with_values
    assign n = opt.name | downcase
    if n == 'size' or n == 'sizes' or n == 'taille' or n == 'größe'
      assign size_option_index = forloop.index0
    endif
  endfor
  assign loading = 'lazy'
  if lazy == false
    assign loading = 'eager'
  endif
-%}
<article class="product-card{% if product.available == false %} product-card--soldout{% endif %}" data-product-card data-product-id="{{ product.id }}">
  <div class="product-card__media media media--portrait" data-card-media {% if img2 %}data-has-second{% endif %}>
    <a href="{{ product.url }}" class="product-card__link" aria-label="{{ product.title | escape }}" tabindex="-1">
      {%- if img1 -%}
        {{ img1 | image_url: width: 1000 | image_tag: loading: loading, widths: '352, 480, 640, 832, 1000', sizes: '(min-width: 1024px) 25vw, (min-width: 768px) 33vw, 50vw', class: 'product-card__img product-card__img--primary', alt: img1.alt | default: product.title }}
      {%- else -%}
        {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
      {%- if img2 -%}
        {{ img2 | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '352, 480, 640, 832, 1000', sizes: '(min-width: 1024px) 25vw, (min-width: 768px) 33vw, 50vw', class: 'product-card__img product-card__img--secondary', alt: img2.alt | default: product.title }}
      {%- endif -%}
    </a>

    {%- if on_sale or is_new or is_premium or is_adult or product.available == false -%}
      <div class="product-card__badges">
        {%- if product.available == false -%}<span class="badge badge--soldout">{{ 'products.product.sold_out' | t }}</span>
        {%- elsif on_sale -%}<span class="badge badge--sale">{{ 'products.product.on_sale' | t }}</span>
        {%- elsif is_new -%}<span class="badge badge--accent">{{ 'products.product.new' | t }}</span>
        {%- endif -%}
        {%- if is_premium -%}<span class="badge">{{ 'products.product.premium' | t }}</span>{%- endif -%}
        {%- if is_adult -%}<span class="badge badge--18" aria-label="18 plus">18</span>{%- endif -%}
      </div>
    {%- endif -%}

    {%- if quick_add and product.available and size_option_index != nil -%}
      <div class="product-card__sizes" role="group" aria-label="{{ 'accessibility.quick_add_label' | t: product: product.title | escape }}">
        {%- for value in product.options_with_values[size_option_index].values -%}
          {%- liquid
            assign variant_for_size = nil
            for v in product.variants
              if v.options[size_option_index] == value and v.available
                assign variant_for_size = v
                break
              endif
            endfor
          -%}
          <button type="button" class="product-card__size" data-quick-add="{{ variant_for_size.id }}" {% unless variant_for_size %}disabled aria-disabled="true"{% endunless %} aria-label="{{ value | escape }} — {{ 'products.product.add_to_cart' | t }}">{{ value }}</button>
        {%- endfor -%}
      </div>
    {%- elsif quick_add and product.available and product.variants.size == 1 -%}
      <div class="product-card__sizes">
        <button type="button" class="product-card__size product-card__size--single" data-quick-add="{{ product.selected_or_first_available_variant.id }}">{{ 'products.product.add_to_cart' | t }}</button>
      </div>
    {%- endif -%}
  </div>

  <div class="product-card__info">
    <h3 class="product-card__title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
    {%- if settings.card_show_vendor -%}<p class="product-card__vendor muted">{{ product.vendor }}</p>{%- endif -%}
    <div class="price{% if on_sale %} price--sale{% endif %}">
      {%- if product.price_varies -%}
        <span class="price__current">{{ 'products.product.from' | t: price: product.price_min | money }}</span>
      {%- else -%}
        <span class="price__current">{{ product.price | money }}</span>
      {%- endif -%}
      {%- if on_sale -%}<s class="price__compare">{{ product.compare_at_price | money }}</s>{%- endif -%}
    </div>
  </div>
</article>
