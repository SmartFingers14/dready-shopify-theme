{%- comment -%} Address add/edit form in a drawer. Params: address, id ('New' or address.id) {%- endcomment -%}
{%- assign is_new = false -%}{%- if id == 'New' -%}{%- assign is_new = true -%}{%- endif -%}
<div id="Address{% if is_new %}New{% else %}Edit-{{ id }}{% endif %}" class="drawer" role="dialog" aria-modal="true" aria-hidden="true" aria-label="{% if is_new %}{{ 'customer.addresses.add_new' | t }}{% else %}{{ 'customer.addresses.edit' | t }}{% endif %}">
  <div class="drawer__header"><span class="label">{% if is_new %}{{ 'customer.addresses.add_new' | t }}{% else %}{{ 'customer.addresses.edit' | t }}{% endif %}</span><button type="button" class="drawer__close" data-drawer-close aria-label="{{ 'accessibility.close' | t }}">{% render 'icon', name: 'close', size: 22 %}</button></div>
  {%- form 'customer_address', address, class: 'drawer__body account__form' -%}
    <div class="contact__row">
      <div class="field"><label class="field__label" for="AF{{ id }}-first">{{ 'customer.addresses.first_name' | t }}</label><input id="AF{{ id }}-first" class="field__input" type="text" name="address[first_name]" value="{{ form.first_name }}" autocomplete="given-name"></div>
      <div class="field"><label class="field__label" for="AF{{ id }}-last">{{ 'customer.addresses.last_name' | t }}</label><input id="AF{{ id }}-last" class="field__input" type="text" name="address[last_name]" value="{{ form.last_name }}" autocomplete="family-name"></div>
    </div>
    <div class="field"><label class="field__label" for="AF{{ id }}-company">{{ 'customer.addresses.company' | t }}</label><input id="AF{{ id }}-company" class="field__input" type="text" name="address[company]" value="{{ form.company }}" autocomplete="organization"></div>
    <div class="field"><label class="field__label" for="AF{{ id }}-a1">{{ 'customer.addresses.address1' | t }}</label><input id="AF{{ id }}-a1" class="field__input" type="text" name="address[address1]" value="{{ form.address1 }}" autocomplete="address-line1"></div>
    <div class="field"><label class="field__label" for="AF{{ id }}-a2">{{ 'customer.addresses.address2' | t }}</label><input id="AF{{ id }}-a2" class="field__input" type="text" name="address[address2]" value="{{ form.address2 }}" autocomplete="address-line2"></div>
    <div class="contact__row">
      <div class="field"><label class="field__label" for="AF{{ id }}-city">{{ 'customer.addresses.city' | t }}</label><input id="AF{{ id }}-city" class="field__input" type="text" name="address[city]" value="{{ form.city }}" autocomplete="address-level2"></div>
      <div class="field"><label class="field__label" for="AF{{ id }}-zip">{{ 'customer.addresses.zip' | t }}</label><input id="AF{{ id }}-zip" class="field__input" type="text" name="address[zip]" value="{{ form.zip }}" autocomplete="postal-code"></div>
    </div>
    <div class="field"><label class="field__label" for="AF{{ id }}-country">{{ 'customer.addresses.country' | t }}</label><select id="AF{{ id }}-country" class="field__input" name="address[country]" data-default="{{ form.country }}" autocomplete="country">{{ all_country_option_tags }}</select></div>
    <div class="field"><label class="field__label" for="AF{{ id }}-province">{{ 'customer.addresses.province' | t }}</label><input id="AF{{ id }}-province" class="field__input" type="text" name="address[province]" value="{{ form.province }}" autocomplete="address-level1"></div>
    <div class="field"><label class="field__label" for="AF{{ id }}-phone">{{ 'customer.addresses.phone' | t }}</label><input id="AF{{ id }}-phone" class="field__input" type="tel" name="address[phone]" value="{{ form.phone }}" autocomplete="tel"></div>
    <label class="checkbox">{{ form.set_as_default_checkbox }} <span>{{ 'customer.addresses.set_default' | t }}</span></label>
    <button type="submit" class="btn btn--full">{% if is_new %}{{ 'customer.addresses.add' | t }}{% else %}{{ 'customer.addresses.update' | t }}{% endif %}</button>
  {%- endform -%}
</div>
