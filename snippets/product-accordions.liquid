{%- comment -%} PDP accordions: description, details & care, shipping & returns. Params: product, section {%- endcomment -%}
<div class="accordion pdp__accordions" data-accordion-single>
  {%- if product.description != blank -%}
    <details class="accordion__item" open>
      <summary class="accordion__summary">{{ 'sections.product.description' | t }} {% render 'icon', name: 'plus', size: 16 %}</summary>
      <div class="accordion__content rte">{{ product.description }}</div>
    </details>
  {%- endif -%}
  {%- if section.settings.care_text != blank -%}
    <details class="accordion__item">
      <summary class="accordion__summary">{{ 'sections.product.details' | t }} {% render 'icon', name: 'plus', size: 16 %}</summary>
      <div class="accordion__content rte">{{ section.settings.care_text }}</div>
    </details>
  {%- endif -%}
  {%- if section.settings.shipping_text != blank -%}
    <details class="accordion__item">
      <summary class="accordion__summary">{{ 'sections.product.shipping_returns' | t }} {% render 'icon', name: 'plus', size: 16 %}</summary>
      <div class="accordion__content rte">{{ section.settings.shipping_text }}</div>
    </details>
  {%- endif -%}
</div>
