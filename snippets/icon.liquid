{%- comment -%}
  Inline SVG icons (Lucide-style, 1.5px stroke). No emoji as icons.
  Usage: {% render 'icon', name: 'cart', size: 20, class: 'icon' %}
  Decorative by default (aria-hidden). Pass label: '...' for meaningful icons.
{%- endcomment -%}
{%- liquid
  assign s = size | default: 20
  assign cls = class | default: 'icon'
-%}
<svg class="{{ cls }}" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" {% if label %}role="img" aria-label="{{ label | escape }}"{% else %}aria-hidden="true" focusable="false"{% endif %}>
  {%- case name -%}
    {%- when 'menu' -%}<path d="M4 7h16M4 12h16M4 17h16"/>
    {%- when 'close' -%}<path d="M18 6 6 18M6 6l12 12"/>
    {%- when 'search' -%}<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>
    {%- when 'cart' -%}<path d="M6 7h14l-1.2 9.6a2 2 0 0 1-2 1.4H9.2a2 2 0 0 1-2-1.4L6 7Z"/><path d="M9 7V6a3 3 0 0 1 6 0v1"/>
    {%- when 'user' -%}<circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>
    {%- when 'arrow-right' -%}<path d="M5 12h14M13 6l6 6-6 6"/>
    {%- when 'arrow-left' -%}<path d="M19 12H5M11 6l-6 6 6 6"/>
    {%- when 'arrow-up-right' -%}<path d="M7 17 17 7M8 7h9v9"/>
    {%- when 'chevron-down' -%}<path d="m6 9 6 6 6-6"/>
    {%- when 'chevron-right' -%}<path d="m9 6 6 6-6 6"/>
    {%- when 'chevron-left' -%}<path d="m15 6-6 6 6 6"/>
    {%- when 'plus' -%}<path d="M12 5v14M5 12h14"/>
    {%- when 'minus' -%}<path d="M5 12h14"/>
    {%- when 'check' -%}<path d="m5 12 5 5L20 7"/>
    {%- when 'play' -%}<path d="M7 5v14l12-7z" fill="currentColor" stroke="none"/>
    {%- when 'pause' -%}<path d="M7 5h4v14H7zM13 5h4v14h-4z" fill="currentColor" stroke="none"/>
    {%- when 'volume' -%}<path d="M4 10v4h4l5 4V6L8 10H4Z"/><path d="M16 9a4 4 0 0 1 0 6"/>
    {%- when 'muted' -%}<path d="M4 10v4h4l5 4V6L8 10H4Z"/><path d="m17 9 4 4m0-4-4 4"/>
    {%- when 'calendar' -%}<rect x="3" y="5" width="18" height="16" rx="1"/><path d="M3 10h18M8 3v4M16 3v4"/>
    {%- when 'pin' -%}<path d="M12 21s-6-5.3-6-10a6 6 0 1 1 12 0c0 4.7-6 10-6 10Z"/><circle cx="12" cy="11" r="2"/>
    {%- when 'ticket' -%}<path d="M3 9a2 2 0 0 0 2-2V5h14v2a2 2 0 0 0 0 4v2a2 2 0 0 0 0 4v2H5v-2a2 2 0 0 0-2-2V9Z"/><path d="M13 5v14"/>
    {%- when 'music' -%}<path d="M9 18V6l11-2v12"/><circle cx="6" cy="18" r="3"/><circle cx="17" cy="16" r="3"/>
    {%- when 'external' -%}<path d="M14 4h6v6M20 4l-9 9"/><path d="M19 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h5"/>
    {%- when 'mail' -%}<rect x="3" y="5" width="18" height="14" rx="1"/><path d="m3 7 9 6 9-6"/>
    {%- when 'globe' -%}<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/>
    {%- when 'truck' -%}<path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="2"/><circle cx="17" cy="18" r="2"/>
    {%- when 'refresh' -%}<path d="M20 11a8 8 0 0 0-14.5-4.5L4 8M4 13a8 8 0 0 0 14.5 4.5L20 16"/><path d="M4 4v4h4M20 20v-4h-4"/>
    {%- when 'shield' -%}<path d="M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6l-8-3Z"/>
    {%- when 'star' -%}<path d="m12 3 2.7 5.6 6.3.9-4.5 4.4 1 6.1L12 17l-5.5 3 1-6.1L3 9.5l6.3-.9L12 3Z"/>
    {%- when 'heart' -%}<path d="M12 20s-7.5-4.6-9.2-9.4C1.6 7.2 4 4 7.2 4c2 0 3.6 1.1 4.8 2.8C13.2 5.1 14.8 4 16.8 4 20 4 22.4 7.2 21.2 10.6 19.5 15.4 12 20 12 20Z"/>
    {%- when 'eye' -%}<path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/>
    {%- when 'image' -%}<rect x="3" y="4" width="18" height="16" rx="1"/><circle cx="9" cy="10" r="2"/><path d="m21 16-5-5-9 9"/>
    {%- when 'instagram' -%}<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/>
    {%- when 'facebook' -%}<path d="M14 8h3V4h-3a4 4 0 0 0-4 4v3H7v4h3v6h4v-6h3l1-4h-4V8Z"/>
    {%- when 'pinterest' -%}<circle cx="12" cy="12" r="9"/><path d="M11.2 21l1.5-7.4"/><path d="M10.4 14c.6 1.3 2.9 1.6 4.2.1 1.6-1.8 1-5.8-2.6-6.3-3.2-.5-5.4 1.7-5.4 4.1 0 1.1.4 1.9 1.1 2.3"/>
    {%- when 'link' -%}<path d="M10 13a5 5 0 0 0 7.07 0l3-3a5 5 0 0 0-7.07-7.07l-1.5 1.5"/><path d="M14 11a5 5 0 0 0-7.07 0l-3 3a5 5 0 0 0 7.07 7.07l1.5-1.5"/>
    {%- when 'share' -%}<circle cx="18" cy="5" r="2.5"/><circle cx="6" cy="12" r="2.5"/><circle cx="18" cy="19" r="2.5"/><path d="m8.2 13.3 7.6 4.4M15.8 6.3l-7.6 4.4"/>
    {%- when 'twitter' -%}<path d="M4 4l16 16M20 4 4 20"/>
    {%- when 'tiktok' -%}<path d="M14 4v10.5a3.5 3.5 0 1 1-3-3.46"/><path d="M14 4c.5 2.5 2.5 4 5 4"/>
    {%- when 'youtube' -%}<rect x="3" y="6" width="18" height="12" rx="3"/><path d="m10 9 5 3-5 3z" fill="currentColor" stroke="none"/>
    {%- when 'spotify' -%}<circle cx="12" cy="12" r="9"/><path d="M7 10c3-1 7-1 10 1M8 13c2.5-.8 5.5-.8 8 .7M9 16c2-.6 4-.6 6 .4"/>
    {%- when 'bandcamp' -%}<path d="M3 17h12l6-10H9z"/>
    {%- when 'filter' -%}<path d="M4 6h16M7 12h10M10 18h4"/>
    {%- when 'grid' -%}<rect x="4" y="4" width="7" height="7"/><rect x="13" y="4" width="7" height="7"/><rect x="4" y="13" width="7" height="7"/><rect x="13" y="13" width="7" height="7"/>
    {%- when 'alert' -%}<circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/>
    {%- when 'lock' -%}<rect x="5" y="11" width="14" height="10" rx="1"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/>
    {%- when 'tag' -%}<path d="M3 12V4h8l9 9-8 8-9-9Z"/><circle cx="7.5" cy="8.5" r="1.5"/>
    {%- when 'ruler' -%}<path d="m3 17 14-14 4 4L7 21l-4-4Z"/><path d="m7 13 2 2M10 10l2 2M13 7l2 2"/>
    {%- else -%}<circle cx="12" cy="12" r="9"/>
  {%- endcase -%}
</svg>
