{%- comment -%} Region + language selectors (footer). {%- endcomment -%}
{%- form 'localization', class: 'footer__localization', data-localization-form: '' -%}
  {%- if show_country and localization.available_countries.size > 1 -%}
    <div class="footer__select">
      <label for="FooterCountry" class="visually-hidden">{{ 'sections.footer.region' | t }}</label>
      {% render 'icon', name: 'globe', size: 16 %}
      <select id="FooterCountry" name="country_code" class="footer__select-el">
        {%- for country in localization.available_countries -%}
          <option value="{{ country.iso_code }}" {% if country.iso_code == localization.country.iso_code %}selected{% endif %}>{{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})</option>
        {%- endfor -%}
      </select>
    </div>
  {%- endif -%}
  {%- if show_locale and localization.available_languages.size > 1 -%}
    <div class="footer__select">
      <label for="FooterLocale" class="visually-hidden">{{ 'sections.footer.language' | t }}</label>
      <select id="FooterLocale" name="locale_code" class="footer__select-el">
        {%- for language in localization.available_languages -%}
          <option value="{{ language.iso_code }}" {% if language.iso_code == localization.language.iso_code %}selected{% endif %}>{{ language.endonym_name | capitalize }}</option>
        {%- endfor -%}
      </select>
    </div>
  {%- endif -%}
{%- endform -%}
