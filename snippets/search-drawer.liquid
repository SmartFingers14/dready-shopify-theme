{%- comment -%} Search drawer with predictive results. {%- endcomment -%}
<div id="SearchDrawer" class="drawer search-drawer" role="dialog" aria-modal="true" aria-label="{{ 'general.search.search' | t }}" aria-hidden="true">
  <div class="drawer__header">
    <span class="label">{{ 'general.search.search' | t }}</span>
    <button type="button" class="drawer__close" data-drawer-close aria-label="{{ 'accessibility.close' | t }}">{% render 'icon', name: 'close', size: 22 %}</button>
  </div>
  <div class="drawer__body search-drawer__body" data-predictive-search>
    <form action="{{ routes.search_url }}" method="get" role="search" class="search-drawer__form">
      <label for="SearchDrawerInput" class="visually-hidden">{{ 'general.search.search' | t }}</label>
      <div class="search-drawer__field">
        {% render 'icon', name: 'search', size: 20 %}
        <input id="SearchDrawerInput" type="search" name="q" class="search-drawer__input" placeholder="{{ 'general.search.placeholder' | t }}" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" data-autofocus>
        <input type="hidden" name="options[prefix]" value="last">
        <button type="submit" class="visually-hidden">{{ 'general.search.search' | t }}</button>
      </div>
    </form>
    <div class="visually-hidden" role="status" aria-live="polite" data-predictive-status></div>
    <div class="search-drawer__results" data-predictive-results hidden></div>
    {%- if linklists['search-trending'].links.size > 0 -%}
      <div class="search-drawer__trending">
        <p class="eyebrow">{{ 'general.search.trending' | t }}</p>
        <ul>
          {%- for link in linklists['search-trending'].links -%}
            <li><a href="{{ link.url }}" class="search-drawer__trend">{{ link.title }} {% render 'icon', name: 'arrow-up-right', size: 14 %}</a></li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
  </div>
</div>
