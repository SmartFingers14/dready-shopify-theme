{%- comment -%} PDP gallery: vertical stack on desktop, horizontal snap on mobile; thumbnails. Params: product, section {%- endcomment -%}
<div class="pdp__gallery" data-gallery>
  {%- if product.media.size > 1 -%}
    <div class="gallery__thumbs" role="tablist" aria-label="{{ 'accessibility.image_of' | t: current: '', total: product.media.size }}">
      {%- for media in product.media -%}
        <button type="button" class="gallery__thumb media media--portrait" data-gallery-thumb aria-current="{% if forloop.first %}true{% else %}false{% endif %}" aria-label="{{ 'accessibility.image_of' | t: current: forloop.index, total: product.media.size }}">
          {{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', sizes: '64px', alt: media.alt | escape }}
        </button>
      {%- endfor -%}
    </div>
  {%- endif -%}
  <div class="gallery__track" data-gallery-track>
    {%- for media in product.media -%}
      <div class="gallery__item media media--portrait" data-media-id="{{ media.id }}">
        {%- case media.media_type -%}
          {%- when 'image' -%}
            {{ media | image_url: width: 1600 | image_tag: loading: forloop.first | default: 'lazy', fetchpriority: forloop.first | default: 'auto', sizes: '(min-width: 1024px) 55vw, 100vw', widths: '480, 750, 1000, 1300, 1600', alt: media.alt | default: product.title | escape }}
          {%- when 'video' -%}
            {{ media | video_tag: controls: true, muted: true, loop: true, playsinline: true, preload: 'metadata' }}
          {%- when 'external_video' -%}
            {{ media | external_video_tag }}
          {%- when 'model' -%}
            {{ media | model_viewer_tag }}
        {%- endcase -%}
      </div>
    {%- else -%}
      <div class="gallery__item media media--portrait">{{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
    {%- endfor -%}
  </div>
</div>
