{%- comment -%} Full cart page (fallback when drawer disabled or JS off). {%- endcomment -%}
<div class="page-width cart-page">
  <header class="page-header"><h1 class="h1">{{ 'sections.cart.title' | t }}</h1></header>
  {%- if cart.item_count == 0 -%}
    <div class="empty-state">
      {% render 'icon', name: 'cart', size: 32 %}
      <p class="h3">{{ 'sections.cart.empty' | t }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="btn">{{ 'sections.cart.continue_shopping' | t }}</a>
    </div>
  {%- else -%}
    <form action="{{ routes.cart_url }}" method="post" class="cart-page__layout">
      <ul class="cart-lines cart-page__lines">
        {%- for item in cart.items -%}
          <li class="cart-line">
            <a href="{{ item.url }}" class="cart-line__media media media--portrait">{%- if item.image -%}{{ item.image | image_url: width: 300 | image_tag: loading: 'lazy', sizes: '120px', alt: item.title | escape }}{%- endif -%}</a>
            <div class="cart-line__info">
              <div class="cart-line__top">
                <div>
                  <a href="{{ item.url }}" class="cart-line__title">{{ item.product.title }}</a>
                  {%- unless item.product.has_only_default_variant -%}<p class="cart-line__variant muted">{{ item.variant.title }}</p>{%- endunless -%}
                </div>
                <div class="price"><span class="price__current">{{ item.final_line_price | money }}</span></div>
              </div>
              <div class="cart-line__bottom">
                <div class="qty" data-qty>
                  <button type="button" class="qty__btn" data-qty-change="-1" aria-label="{{ 'accessibility.decrement' | t }}">{% render 'icon', name: 'minus', size: 14 %}</button>
                  <input type="number" name="updates[]" class="qty__input" value="{{ item.quantity }}" min="0" aria-label="{{ 'sections.cart.quantity' | t }}">
                  <button type="button" class="qty__btn" data-qty-change="1" aria-label="{{ 'accessibility.increment' | t }}">{% render 'icon', name: 'plus', size: 14 %}</button>
                </div>
                <a href="{{ item.url_to_remove }}" class="cart-line__remove link-underline">{{ 'sections.cart.remove' | t }}</a>
              </div>
            </div>
          </li>
        {%- endfor -%}
      </ul>
      <aside class="cart-page__summary">
        {%- if section.settings.show_note -%}
          <div class="field">
            <label for="CartNote" class="field__label">{{ 'cart.general.note' | t }}</label>
            <textarea id="CartNote" name="note" class="field__input">{{ cart.note }}</textarea>
          </div>
        {%- endif -%}
        <div class="cart-drawer__subtotal"><span class="label">{{ 'sections.cart.subtotal' | t }}</span><span class="cart-drawer__total">{{ cart.total_price | money }}</span></div>
        <p class="cart-drawer__tax muted">{{ 'sections.cart.taxes_and_shipping_at_checkout' | t }}</p>
        <button type="submit" name="update" class="btn btn--outline btn--full">Update</button>
        <button type="submit" name="checkout" class="btn btn--full">{{ 'sections.cart.checkout' | t }}</button>
      </aside>
    </form>
  {%- endif -%}
</div>
{% schema %}
{ "name": "Cart page", "settings": [ { "type": "checkbox", "id": "show_note", "label": "Show order note", "default": true } ] }
{% endschema %}
