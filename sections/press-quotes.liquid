{%- comment -%}
  Press & voices — social proof. Large quotes on a Swiss grid with the source set as a
  bold uppercase label and a link to the full story. First quote is featured full width.
{%- endcomment -%}
{%- assign s = section.settings -%}
<section class="section press{% if s.dark %} section--dark{% endif %}">
  <div class="page-width">
    <header class="section-header">
      <div class="section-header__text">
        {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="h1">{{ s.heading }}</h2>{%- endif -%}
      </div>
    </header>
    <ul class="press__grid reveal-stagger" role="list">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <li class="press__item{% if forloop.first %} press__item--lead{% endif %}" {{ block.shopify_attributes }}>
          <figure class="press__figure">
            <span class="press__mark" aria-hidden="true">&ldquo;</span>
            <blockquote class="press__quote">{{ b.quote }}</blockquote>
            <figcaption class="press__source">
              <span class="press__name">{{ b.source }}</span>
              {%- if b.context != blank -%}<span class="press__context">{{ b.context }}</span>{%- endif -%}
            </figcaption>
          </figure>
          {%- if b.url != blank -%}<a href="{{ b.url }}" class="link-underline press__link">{{ b.link_label | default: s.link_label }}<span class="visually-hidden"> — {{ b.source }}</span></a>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Press quotes",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "As seen in" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What they said" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Read the story" },
    { "type": "checkbox", "id": "dark", "label": "Dark band", "default": false }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Quote",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote" },
        { "type": "text", "id": "source", "label": "Source", "default": "Publication" },
        { "type": "text", "id": "context", "label": "Context", "info": "e.g. Dready × Vice" },
        { "type": "url", "id": "url", "label": "Link" },
        { "type": "text", "id": "link_label", "label": "Link label" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [ { "name": "Press quotes", "blocks": [ { "type": "quote" }, { "type": "quote" }, { "type": "quote" } ] } ]
}
{% endschema %}
