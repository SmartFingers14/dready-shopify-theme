{%- comment -%}
  Events — interactive flyers. Client adds events as blocks. Front: flyer image + date chip.
  Tap/click "Details" flips the card to reveal venue, time, description, Get Tickets.
  Keyboard: button toggles, Esc closes; back face is inert while hidden.
{%- endcomment -%}
{%- assign s = section.settings -%}
<section class="section events section--dark" data-scroller-wrap>
  <div class="page-width">
    <header class="section-header">
      <div class="section-header__text">
        {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="h1">{{ s.heading }}</h2>{%- endif -%}
      </div>
      <div class="section-header__actions">
        <div class="scroller-controls">
          <button type="button" class="icon-btn" data-scroller-prev aria-label="{{ 'accessibility.previous_slide' | t }}">{% render 'icon', name: 'arrow-left' %}</button>
          <button type="button" class="icon-btn" data-scroller-next aria-label="{{ 'accessibility.next_slide' | t }}">{% render 'icon', name: 'arrow-right' %}</button>
        </div>
        {%- if s.view_all_url != blank -%}<a href="{{ s.view_all_url }}" class="link-underline section-header__link">{{ s.view_all_text }}</a>{%- endif -%}
      </div>
    </header>

    <div class="scroller scroller--3 reveal-stagger" data-scroller>
      {%- for block in section.blocks -%}
        {%- assign uid = section.id | append: '-' | append: forloop.index -%}
        {% render 'event-card', block: block, uid: uid %}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Events",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Dready live" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Events" },
    { "type": "text", "id": "view_all_text", "label": "View all text", "default": "All events" },
    { "type": "url", "id": "view_all_url", "label": "View all link" }
  ],
  "blocks": [
    {
      "type": "event",
      "name": "Event",
      "settings": [
        { "type": "image_picker", "id": "flyer", "label": "Flyer (3:4 portrait)" },
        { "type": "text", "id": "title", "label": "Title", "default": "Dready Sound System" },
        { "type": "text", "id": "day", "label": "Day", "default": "18" },
        { "type": "text", "id": "month", "label": "Month", "default": "OCT" },
        { "type": "text", "id": "year", "label": "Year", "default": "2026" },
        { "type": "text", "id": "time", "label": "Time", "default": "10pm – 4am" },
        { "type": "text", "id": "venue", "label": "Venue", "default": "The Night Owl" },
        { "type": "text", "id": "city", "label": "City", "default": "Birmingham" },
        { "type": "text", "id": "lineup", "label": "Line-up" },
        { "type": "textarea", "id": "text", "label": "Description" },
        { "type": "text", "id": "status", "label": "Status badge", "default": "On sale" },
        { "type": "url", "id": "ticket_url", "label": "Ticket link" },
        { "type": "text", "id": "ticket_text", "label": "Ticket button text", "default": "Get tickets" },
        { "type": "url", "id": "map_url", "label": "Map link" },
        { "type": "checkbox", "id": "past", "label": "Past event", "default": false }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Events",
      "blocks": [
        { "type": "event" },
        { "type": "event", "settings": { "title": "Roots Reggae Sessions", "day": "02", "month": "NOV", "venue": "Hare & Hounds", "city": "Birmingham", "status": "Low stock" } },
        { "type": "event", "settings": { "title": "Dready × Carnival", "day": "24", "month": "AUG", "venue": "Notting Hill", "city": "London", "past": true } }
      ]
    }
  ]
}
{% endschema %}
