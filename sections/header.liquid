{%- comment -%}
  Header — Daily Paper pattern: slim bar, logo, menu, search, account, basket.
  Desktop: inline nav with image-rich mega menus. Mobile: hamburger → drawer.
  Transparent over the hero on the homepage, solid on scroll.
{%- endcomment -%}
{%- liquid
  assign menu = section.settings.menu
  assign transparent = false
  if section.settings.transparent_home and template.name == 'index'
    assign transparent = true
  endif
  assign logo_h = settings.logo_height
-%}
<header class="header{% if transparent %} header--transparent{% endif %}{% if section.settings.sticky %} header--sticky{% endif %}{% if menu.links.size <= 5 %} header--compact-nav{% endif %}" data-header {% if section.settings.hide_on_scroll %}data-hide-on-scroll{% endif %} style="--logo-h: {{ logo_h }}px;">
  <div class="header__inner page-width">

    <div class="header__left">
      <button type="button" class="header__icon header__burger" data-drawer-open="MenuDrawer" aria-controls="MenuDrawer" aria-expanded="false" aria-label="{{ 'accessibility.open_menu' | t }}">
        {% render 'icon', name: 'menu', size: 22 %}
      </button>

      <nav class="header__nav" aria-label="{{ 'sections.header.menu' | t }}">
        <ul class="header__menu">
          {%- for link in menu.links -%}
            {%- assign placeholder_url = false -%}
            {%- if link.url == '#' or link.url == blank -%}{%- assign placeholder_url = true -%}{%- endif -%}
            {%- if link.links.size > 0 -%}
              <li class="header__menu-item" data-mega-item>
                {%- if placeholder_url -%}
                  <button type="button" class="nav-link header__menu-link{% if link.child_active %} is-active{% endif %}" data-mega-trigger aria-expanded="false" aria-controls="MegaMenu-{{ forloop.index }}">
                    <span>{{ link.title }}</span>{% render 'icon', name: 'chevron-down', size: 14 %}
                  </button>
                {%- else -%}
                  <a href="{{ link.url }}" class="nav-link header__menu-link{% if link.active or link.child_active %} is-active{% endif %}" data-mega-trigger aria-expanded="false" aria-controls="MegaMenu-{{ forloop.index }}"{% if link.active %} aria-current="page"{% endif %}>
                    <span>{{ link.title }}</span>{% render 'icon', name: 'chevron-down', size: 14 %}
                  </a>
                {%- endif -%}
                {% render 'mega-menu', link: link, section: section, index: forloop.index %}
              </li>
            {%- else -%}
              <li class="header__menu-item">
                <a href="{{ link.url }}" class="nav-link header__menu-link{% if link.active %} is-active{% endif %}"{% if link.active %} aria-current="page"{% endif %}><span>{{ link.title }}</span></a>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </nav>
    </div>

    <a href="{{ routes.root_url }}" class="header__logo" aria-label="{{ shop.name | escape }}">
      {%- if settings.logo != blank -%}
        {%- assign shop_alt = shop.name | escape -%}
        {{ settings.logo | image_url: width: 400 | image_tag: loading: 'eager', fetchpriority: 'high', height: logo_h, alt: shop_alt, class: 'header__logo-img' }}
      {%- else -%}
        <img src="{{ 'dready-logo.png' | asset_url }}" alt="{{ shop.name | escape }}" class="header__logo-img" height="{{ logo_h }}" width="{{ logo_h }}" loading="eager">
      {%- endif -%}
      {%- if section.settings.wordmark != blank -%}
        <span class="header__wordmark">{{ section.settings.wordmark }}</span>
      {%- endif -%}
    </a>

    <div class="header__right">
      <button type="button" class="header__icon" data-drawer-open="SearchDrawer" aria-controls="SearchDrawer" aria-expanded="false" aria-label="{{ 'accessibility.open_search' | t }}">
        {% render 'icon', name: 'search', size: 20 %}
        <span class="header__icon-text label">{{ 'sections.header.search' | t }}</span>
      </button>
      {%- if shop.customer_accounts_enabled -%}
        <a href="{{ routes.account_url }}" class="header__icon header__icon--account" aria-label="{{ 'sections.header.account' | t }}">
          {% render 'icon', name: 'user', size: 20 %}
        </a>
      {%- endif -%}
      <button type="button" class="header__icon header__cart" data-drawer-open="CartDrawer" aria-controls="CartDrawer" aria-expanded="false" aria-label="{{ 'accessibility.open_cart' | t }}">
        <span class="header__icon-text label">{{ 'sections.header.cart' | t }}</span>
        <span class="header__cart-count{% if cart.item_count == 0 %} is-empty{% endif %}" data-cart-count>{{ cart.item_count }}</span>
      </button>
    </div>
  </div>
  <div class="mega-scrim" data-mega-scrim aria-hidden="true"></div>
</header>

{% render 'menu-drawer', menu: menu, section: section %}

{% schema %}
{
  "name": "Header",
  "class": "shopify-section-header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Main menu", "default": "main-menu" },
    { "type": "text", "id": "wordmark", "label": "Wordmark next to logo", "default": "DREADY", "info": "Leave blank to show the logo only." },
    { "type": "checkbox", "id": "sticky", "label": "Sticky header", "default": true },
    { "type": "checkbox", "id": "hide_on_scroll", "label": "Hide when scrolling down", "default": false },
    { "type": "checkbox", "id": "transparent_home", "label": "Transparent over homepage hero", "default": true },
    { "type": "header", "content": "Mobile menu" },
    { "type": "link_list", "id": "secondary_menu", "label": "Secondary links (mobile drawer footer)", "info": "e.g. Stores, FAQ, Contact" },
    { "type": "header", "content": "Dropdown menus" },
    { "type": "text", "id": "mega_note", "label": "Note under the dropdown links", "default": "Made to order in the UK — allow 5 working days" }
  ],
  "blocks": [
    {
      "type": "mega_promo",
      "name": "Menu image tiles",
      "settings": [
        { "type": "text", "id": "menu_item", "label": "Menu item title", "info": "Must match a top-level menu item exactly, e.g. “Shop”. The tiles show in that item’s dropdown and in the mobile menu." },
        { "type": "header", "content": "Tile 1" },
        { "type": "image_picker", "id": "image_1", "label": "Image" },
        { "type": "text", "id": "asset_1", "label": "Theme image file (fallback)", "info": "Used when no image is picked, e.g. music-selecta.jpg" },
        { "type": "text", "id": "caption_1", "label": "Title", "default": "New arrivals" },
        { "type": "text", "id": "sub_1", "label": "Subtitle" },
        { "type": "url", "id": "url_1", "label": "Link" },
        { "type": "header", "content": "Tile 2" },
        { "type": "image_picker", "id": "image_2", "label": "Image" },
        { "type": "text", "id": "asset_2", "label": "Theme image file (fallback)" },
        { "type": "text", "id": "caption_2", "label": "Title", "default": "Premium" },
        { "type": "text", "id": "sub_2", "label": "Subtitle" },
        { "type": "url", "id": "url_2", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 6
}
{% endschema %}
