{%- comment -%}
  About — values. Four big Rasta-coloured value tiles (word + line; the line slides up on
  hover / is always shown on touch), then a row of promises with icons.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign values = section.blocks | where: 'type', 'value'
  assign promises = section.blocks | where: 'type', 'promise'
-%}
<section class="section about-values" id="{{ s.anchor | default: 'values' | handleize }}">
  <div class="page-width">
    <header class="section-header">
      <div class="section-header__text">
        {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="h1">{{ s.heading }}</h2>{%- endif -%}
      </div>
      {%- if s.text != blank -%}<p class="about-values__intro">{{ s.text }}</p>{%- endif -%}
    </header>

    {%- if values.size > 0 -%}
      <ul class="about-values__grid reveal-stagger" role="list">
        {%- for block in values -%}
          <li class="about-value about-value--{{ block.settings.color }}" tabindex="0" {{ block.shopify_attributes }}>
            <span class="about-value__num">{{ forloop.index | prepend: '0' }}</span>
            <h3 class="about-value__word">{{ block.settings.word }}</h3>
            <p class="about-value__text">{{ block.settings.text }}</p>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if promises.size > 0 -%}
      <ul class="about-promises reveal-stagger" role="list">
        {%- for block in promises -%}
          <li class="about-promise" {{ block.shopify_attributes }}>
            <span class="about-promise__icon">{% render 'icon', name: block.settings.icon, size: 22 %}</span>
            <span class="about-promise__text"><strong>{{ block.settings.title }}</strong><span>{{ block.settings.text }}</span></span>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "About values",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "values" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The message" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What we stand for" },
    { "type": "text", "id": "text", "label": "Intro" }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value",
      "settings": [
        { "type": "text", "id": "word", "label": "Word", "default": "Peace" },
        { "type": "textarea", "id": "text", "label": "Text" },
        { "type": "select", "id": "color", "label": "Colour", "options": [ { "value": "green", "label": "Green" }, { "value": "gold", "label": "Gold" }, { "value": "red", "label": "Red" }, { "value": "black", "label": "Black" } ], "default": "green" }
      ]
    },
    {
      "type": "promise",
      "name": "Promise",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icon",
          "options": [ { "value": "heart", "label": "Heart" }, { "value": "globe", "label": "Globe" }, { "value": "shield", "label": "Shield" }, { "value": "refresh", "label": "Made to order" }, { "value": "star", "label": "Star" }, { "value": "truck", "label": "Truck" }, { "value": "user", "label": "Person" }, { "value": "music", "label": "Music" } ],
          "default": "heart"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Promise" },
        { "type": "text", "id": "text", "label": "Text" }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [ { "name": "About values", "blocks": [ { "type": "value" }, { "type": "value" }, { "type": "value" }, { "type": "value" } ] } ]
}
{% endschema %}
