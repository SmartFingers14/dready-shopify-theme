{%- comment -%}
  Product page — Daily Paper PDP pattern: scrolling gallery left, sticky buy panel right.
  Variant picker (colour swatches + size buttons), size guide, accordions, trust strip.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign current = product.selected_or_first_available_variant
  assign form_id = 'ProductForm-' | append: section.id
  assign on_sale = false
  if current.compare_at_price > current.price
    assign on_sale = true
  endif
  assign is_premium = false
  if product.tags contains 'premium' or product.tags contains 'Premium'
    assign is_premium = true
  endif
  assign made_to_order = false
  if product.tags contains 'made-to-order' or product.description contains 'made to order' or product.description contains 'working days'
    assign made_to_order = true
  endif
-%}
<div class="pdp page-width">
  <nav class="breadcrumb pdp__crumbs" aria-label="Breadcrumb">
    <a href="{{ routes.root_url }}">{{ 'general.breadcrumbs.home' | t }}</a><span aria-hidden="true">/</span>
    {%- if collection -%}<a href="{{ collection.url }}">{{ collection.title }}</a><span aria-hidden="true">/</span>{%- endif -%}
    <span aria-current="page">{{ product.title }}</span>
  </nav>

  <div class="pdp__layout">
    {%- if product.gift_card? -%}
      <div class="pdp__gallery pdp__gallery--gift">
        <div class="pdp-gift__stage">
          {%- assign gift_value = current.price | money -%}
          {% render 'gift-card-visual', value: gift_value, live: true %}
        </div>
        <ul class="pdp-gift__facts">
          <li>{% render 'icon', name: 'mail', size: 16 %} {{ 'gift_card.fact_email' | t }}</li>
          <li>{% render 'icon', name: 'calendar', size: 16 %} {{ 'gift_card.fact_schedule' | t }}</li>
          <li>{% render 'icon', name: 'tag', size: 16 %} {{ 'gift_card.fact_spend' | t }}</li>
        </ul>
      </div>
    {%- else -%}
      {% render 'product-gallery', product: product, section: section %}
    {%- endif -%}

    <div class="pdp__panel">
      <div class="pdp__info">
        <div class="pdp__badges">
          {%- if on_sale -%}<span class="badge badge--sale">{{ 'products.product.on_sale' | t }}</span>{%- endif -%}
          {%- if is_premium -%}<span class="badge">{{ 'products.product.premium' | t }}</span>{%- endif -%}
          {%- if made_to_order -%}<span class="badge badge--outline">{{ 'sections.product.made_to_order' | t }}</span>{%- endif -%}
        </div>
        {%- if s.show_vendor -%}<p class="eyebrow">{{ product.vendor }}</p>{%- endif -%}
        <h1 class="pdp__title h2">{{ product.title }}</h1>
        <div class="price pdp__price{% if on_sale %} price--sale{% endif %}">
          <span class="price__current" data-product-price>{{ current.price | money }}</span>
          <s class="price__compare" data-product-compare {% unless on_sale %}hidden{% endunless %}>{{ current.compare_at_price | money }}</s>
        </div>
        {%- if cart.taxes_included -%}<p class="pdp__tax muted">{{ 'products.product.include_taxes' | t }}</p>{%- endif -%}
        {%- comment -%} Pay-later messaging (Clearpay / Afterpay / Klarna) attaches here — point the app's product price selector at #ProductInstallments {%- endcomment -%}
        <div class="pdp__installments" id="ProductInstallments" data-installments></div>
        {%- for block in section.blocks -%}
          {%- if block.type == '@app' -%}<div class="pdp__app">{% render block %}</div>{%- endif -%}
        {%- endfor -%}
      </div>

      {% render 'product-form', product: product, current: current, form_id: form_id, section: section %}

      {%- if made_to_order and s.made_to_order_text != blank -%}
        <p class="pdp__notice">{% render 'icon', name: 'alert', size: 16 %} {{ s.made_to_order_text }}</p>
      {%- endif -%}

      {% render 'product-accordions', product: product, section: section %}

      {%- if section.blocks.size > 0 and product.gift_card? == false -%}
        <ul class="pdp__trust">
          {%- for block in section.blocks -%}
            {%- if block.type == 'trust' -%}
              <li {{ block.shopify_attributes }}>{% render 'icon', name: block.settings.icon, size: 16 %} <span>{{ block.settings.text }}</span></li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if s.show_share -%}{% render 'product-share', product: product %}{%- endif -%}
    </div>
  </div>
</div>

{%- comment -%} Structured data for Google (Product + BreadcrumbList) {%- endcomment -%}
{{ product | structured_data }}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": {{ 'general.breadcrumbs.home' | t | json }}, "item": {{ shop.url | json }} }
      {%- if collection -%}
      , { "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ shop.url | append: collection.url | json }} }
      , { "@type": "ListItem", "position": 3, "name": {{ product.title | json }}, "item": {{ shop.url | append: product.url | json }} }
      {%- else -%}
      , { "@type": "ListItem", "position": 2, "name": {{ product.title | json }}, "item": {{ shop.url | append: product.url | json }} }
      {%- endif -%}
    ]
  }
</script>

{% schema %}
{
  "name": "Product",
  "settings": [
    { "type": "checkbox", "id": "show_vendor", "label": "Show vendor", "default": false },
    { "type": "checkbox", "id": "show_quantity", "label": "Show quantity selector", "default": true },
    { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show dynamic checkout button", "info": "Buy it now / Shop Pay / Apple Pay. Hidden automatically on gift cards so recipient details are kept.", "default": true },
    { "type": "checkbox", "id": "show_share", "label": "Show share links", "default": true },
    { "type": "checkbox", "id": "swatches", "label": "Show colour swatches", "default": true },
    { "type": "page", "id": "size_guide", "label": "Size guide page" },
    { "type": "text", "id": "made_to_order_text", "label": "Made-to-order notice", "default": "Hand-embroidered to order. Please allow 5 working days before dispatch." },
    { "type": "header", "content": "Accordions" },
    { "type": "richtext", "id": "shipping_text", "label": "Shipping & returns", "default": "<p>Free UK shipping over £75. 30-day returns on unworn items. Made-to-order pieces are final sale.</p>" },
    { "type": "richtext", "id": "care_text", "label": "Details & care", "default": "<p>Wash cold inside out. Do not tumble dry embroidery.</p>" }
  ],
  "blocks": [
    { "type": "@app" },
    { "type": "trust", "name": "Trust point", "settings": [ { "type": "select", "id": "icon", "label": "Icon", "options": [ { "value": "truck", "label": "Shipping" }, { "value": "refresh", "label": "Returns" }, { "value": "shield", "label": "Secure" }, { "value": "star", "label": "Quality" } ], "default": "truck" }, { "type": "text", "id": "text", "label": "Text", "default": "Worldwide shipping" } ] }
  ],
  "max_blocks": 8
}
{% endschema %}
