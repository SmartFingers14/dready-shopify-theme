{%- comment -%}
  Scrolling announcement marquee (Daily Paper style).
  Accessible: pause/play control, stops on hover, respects reduced motion.
  Messages are blocks; the track is duplicated for a seamless loop.
{%- endcomment -%}
{%- if section.blocks.size > 0 -%}
<div class="announcement{% if section.settings.dark %} announcement--dark{% endif %}" data-marquee style="--marquee-speed: {{ section.settings.speed }}s;">
  <div class="announcement__inner">
    <div class="announcement__track" aria-hidden="true">
      {%- for i in (1..2) -%}
        <ul class="announcement__list">
          {%- for block in section.blocks -%}
            <li class="announcement__item" {{ block.shopify_attributes }}>
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
              {%- else -%}
                <span>{{ block.settings.text }}</span>
              {%- endif -%}
              <span class="announcement__sep">&bull;</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endfor -%}
    </div>
    {%- comment -%} Screen readers get a static, non-duplicated list {%- endcomment -%}
    <ul class="visually-hidden">
      {%- for block in section.blocks -%}<li>{{ block.settings.text }}</li>{%- endfor -%}
    </ul>
    <button type="button" class="announcement__toggle" data-marquee-toggle data-pause-label="{{ 'accessibility.pause_announcement' | t }}" data-play-label="{{ 'accessibility.play_announcement' | t }}" aria-pressed="false">
      <span class="announcement__toggle-pause">{% render 'icon', name: 'pause', size: 12 %}</span>
      <span class="announcement__toggle-play">{% render 'icon', name: 'play', size: 12 %}</span>
    </button>
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "class": "shopify-section-announcement",
  "settings": [
    { "type": "range", "id": "speed", "min": 10, "max": 60, "step": 5, "unit": "s", "label": "Loop duration", "default": 30, "info": "Lower = faster." },
    { "type": "checkbox", "id": "dark", "label": "Dark background", "default": true }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free UK shipping over £75" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [
        { "type": "message", "settings": { "text": "EU customers: we pay all taxes on orders under €150" } },
        { "type": "message", "settings": { "text": "Embroidered pieces are made to order — allow 5 working days" } },
        { "type": "message", "settings": { "text": "Born in Birmingham, 1983" } }
      ]
    }
  ]
}
{% endschema %}
