{%- comment -%}
  Join the family — Daily Paper "UNITE" membership × Nervous culture band.
  A living wall of real community photos (two counter-drifting rows, pausable, still for
  reduced motion), a big statement, numbered perks, optional "I'm into" chips that tag the
  subscriber, and a one-field email form with loading → "Welcome to the family" feedback
  (AJAX with a plain-POST fallback). Blocks: perk, interest, photo.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign form_id = 'FamilyForm-' | append: section.id
  assign photo_count = 0
  assign interest_count = 0
  for block in section.blocks
    if block.type == 'photo'
      assign photo_count = photo_count | plus: 1
    elsif block.type == 'interest'
      assign interest_count = interest_count | plus: 1
    endif
  endfor
  assign half = photo_count | divided_by: 2 | at_least: 1
-%}
<section class="section family{% if s.dark %} section--dark{% endif %}" data-family>
  {%- if photo_count > 1 -%}
    <div class="family__wall" data-family-wall>
      {%- for row in (1..2) -%}
        <div class="family__row family__row--{{ row }}" aria-hidden="true">
          <div class="family__track">
            {%- for pass in (1..2) -%}
              {%- assign n = 0 -%}
              {%- for block in section.blocks -%}
                {%- if block.type == 'photo' -%}
                  {%- assign n = n | plus: 1 -%}
                  {%- if row == 1 and n > half -%}{%- continue -%}{%- endif -%}
                  {%- if row == 2 and n <= half -%}{%- continue -%}{%- endif -%}
                  <div class="family__photo">
                    {% render 'culture-image', image: block.settings.image, asset: block.settings.asset, alt: '', sizes: '200px' %}
                  </div>
                {%- endif -%}
              {%- endfor -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endfor -%}
      <button type="button" class="family__wall-toggle" data-family-pause aria-pressed="false" aria-label="{{ 'sections.community.pause_wall' | t }}">
        <span class="family__wall-pause">{% render 'icon', name: 'pause', size: 14 %}</span>
        <span class="family__wall-play">{% render 'icon', name: 'play', size: 14 %}</span>
      </button>
      {%- if s.wall_caption != blank -%}<p class="family__wall-caption label">{{ s.wall_caption }}</p>{%- endif -%}
    </div>
  {%- endif -%}

  <div class="page-width family__inner">
    <div class="family__intro reveal">
      {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      <h2 class="h-hero family__heading">{{ s.heading }}</h2>
      <span class="family__stripe" aria-hidden="true"></span>
      {%- if s.text != blank -%}<p class="body-lg family__text">{{ s.text }}</p>{%- endif -%}

      <ol class="family__perks" role="list">
        {%- assign p = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'perk' -%}
            {%- assign p = p | plus: 1 -%}
            <li class="family__perk" {{ block.shopify_attributes }}>
              <span class="family__perk-num">{{ p | prepend: '0' | slice: -2, 2 }}</span>
              <span class="family__perk-icon">{% render 'icon', name: block.settings.icon, size: 20 %}</span>
              <span class="family__perk-text">
                {%- if block.settings.title != blank -%}<strong>{{ block.settings.title }}</strong>{%- endif -%}
                <span>{{ block.settings.text }}</span>
              </span>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ol>
    </div>

    <div class="family__join reveal">
      {%- form 'customer', id: form_id, class: 'family__form', data-family-form: '' -%}
        <input type="hidden" name="contact[tags]" value="{{ s.base_tags | default: 'newsletter,community' }}" data-family-tags data-base="{{ s.base_tags | default: 'newsletter,community' }}">
        {%- if form.posted_successfully? -%}
          <div class="family__success is-shown" role="status" tabindex="-1" data-family-success>
            <span class="family__success-icon" aria-hidden="true">{% render 'icon', name: 'check', size: 28 %}</span>
            <p class="h2">{{ s.success_heading }}</p>
            <p class="family__success-text">{{ s.success_text }}</p>
          </div>
        {%- else -%}
          <div class="family__form-body" data-family-body>
            <p class="family__form-title label">{{ s.form_heading }}</p>

            {%- if interest_count > 0 -%}
              <fieldset class="family__interests">
                <legend class="family__legend">{{ s.interests_label }} <span class="muted">({{ 'gift_card.recipient.optional' | t }})</span></legend>
                <div class="family__chips">
                  {%- for block in section.blocks -%}
                    {%- if block.type == 'interest' -%}
                      {%- assign chip_id = form_id | append: '-i-' | append: forloop.index -%}
                      {%- assign chip_tag = block.settings.tag | strip -%}
                      {%- if chip_tag == blank -%}{%- assign chip_tag = block.settings.label | handle | prepend: 'interest-' -%}{%- endif -%}
                      <label class="family__chip" for="{{ chip_id }}" {{ block.shopify_attributes }}>
                        <input type="checkbox" id="{{ chip_id }}" value="{{ chip_tag | escape }}" data-family-interest>
                        <span>{{ block.settings.label }}</span>
                      </label>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              </fieldset>
            {%- endif -%}

            <div class="family__field">
              <label class="family__label" for="{{ form_id }}-email">{{ 'general.newsletter.label' | t }}</label>
              <div class="family__inline">
                <input id="{{ form_id }}-email" type="email" name="contact[email]" class="field__input family__input" placeholder="you@example.com" required autocomplete="email" aria-describedby="{{ form_id }}-error" {% if form.errors %}aria-invalid="true"{% endif %}>
                <button type="submit" class="btn btn--accent family__submit" data-family-submit>
                  <span class="family__submit-label">{{ s.button_text }}</span>
                  {% render 'icon', name: 'arrow-right', size: 16 %}
                </button>
              </div>
              <p class="field__error family__error" id="{{ form_id }}-error" role="alert" data-family-error{% unless form.errors %} hidden{% endunless %}>
                {% render 'icon', name: 'alert', size: 14 %}
                <span data-family-error-text>{%- if form.errors -%}{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}{%- else -%}{{ 'sections.community.email_error' | t }}{%- endif -%}</span>
              </p>
            </div>
            {%- if s.small_print != blank -%}<p class="family__small">{{ s.small_print }}</p>{%- endif -%}
          </div>
          <div class="family__success" role="status" tabindex="-1" hidden data-family-success>
            <span class="family__success-icon" aria-hidden="true">{% render 'icon', name: 'check', size: 28 %}</span>
            <p class="h2">{{ s.success_heading }}</p>
            <p class="family__success-text">{{ s.success_text }}</p>
          </div>
        {%- endif -%}
      {%- endform -%}

      {%- if s.show_social -%}
        <div class="family__social">
          <p class="family__social-text">{{ s.social_text }}</p>
          {% render 'social-links', size: 20 %}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Join the family",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image (unused — add photos as blocks)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Dready family" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join the family" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Early access to drops, event guest lists, collab previews and 10% off your first order." },
    { "type": "text", "id": "form_heading", "label": "Form heading", "default": "Get on the list" },
    { "type": "text", "id": "interests_label", "label": "Interests label", "default": "I'm into" },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "Join" },
    { "type": "text", "id": "small_print", "label": "Small print", "default": "No spam. Unsubscribe any time." },
    { "type": "text", "id": "success_heading", "label": "Success heading", "default": "Welcome to the family" },
    { "type": "text", "id": "success_text", "label": "Success text", "default": "You're on the list. Check your inbox for your 10% code." },
    { "type": "text", "id": "base_tags", "label": "Customer tags", "default": "newsletter,community", "info": "Interests are added as interest-… tags." },
    { "type": "text", "id": "wall_caption", "label": "Photo wall caption", "default": "#DreadyFamily — tag @dreadybrand" },
    { "type": "checkbox", "id": "show_social", "label": "Show social links", "default": true },
    { "type": "text", "id": "social_text", "label": "Social line", "default": "Tag @dreadybrand to get on the wall." },
    { "type": "checkbox", "id": "dark", "label": "Dark background", "default": true }
  ],
  "blocks": [
    {
      "type": "perk",
      "name": "Perk",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [ { "value": "star", "label": "Star" }, { "value": "tag", "label": "Tag" }, { "value": "ticket", "label": "Ticket" }, { "value": "music", "label": "Music" }, { "value": "eye", "label": "Eye" }, { "value": "check", "label": "Check" } ], "default": "star" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "text", "label": "Text", "default": "Early access to every drop" }
      ]
    },
    {
      "type": "interest",
      "name": "Interest chip",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Drops" },
        { "type": "text", "id": "tag", "label": "Tag (optional)", "info": "Saved on the subscriber, e.g. interest-music. Defaults to the label." }
      ]
    },
    {
      "type": "photo",
      "name": "Wall photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "asset", "label": "Theme image file", "info": "Used when no image is picked above." }
      ]
    }
  ],
  "max_blocks": 40,
  "presets": [
    {
      "name": "Join the family",
      "blocks": [
        { "type": "perk", "settings": { "icon": "star", "title": "First in line", "text": "Early access to every drop" } },
        { "type": "perk", "settings": { "icon": "ticket", "title": "On the list", "text": "Event guest lists & presales" } },
        { "type": "perk", "settings": { "icon": "tag", "title": "10% off", "text": "Your first order" } },
        { "type": "interest", "settings": { "label": "Drops" } },
        { "type": "interest", "settings": { "label": "Music" } },
        { "type": "interest", "settings": { "label": "Events" } }
      ]
    }
  ]
}
{% endschema %}
