<div class="page-width">
  <header class="page-header"><h1 class="h1">{{ section.settings.heading }}</h1></header>
  <div class="grid grid--3 reveal-stagger">
    {%- for collection in collections -%}
      {%- unless collection.handle == 'frontpage' or collection.handle == 'all' -%}
        <a href="{{ collection.url }}" class="collab">
          <div class="collab__media media media--portrait">
            {%- if collection.image -%}{{ collection.image | image_url: width: 1000 | image_tag: loading: 'lazy', sizes: '(min-width: 1024px) 33vw, 50vw', alt: collection.title | escape }}
            {%- elsif collection.products.first.featured_media -%}{{ collection.products.first.featured_media | image_url: width: 1000 | image_tag: loading: 'lazy', sizes: '(min-width: 1024px) 33vw, 50vw', alt: collection.title | escape }}
            {%- else -%}{{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}{%- endif -%}
          </div>
          <div class="collab__info"><h2 class="h3">{{ collection.title }}</h2><span class="muted">{{ collection.products_count }} products</span></div>
        </a>
      {%- endunless -%}
    {%- endfor -%}
  </div>
</div>
{% schema %}
{ "name": "Collections list", "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" } ] }
{% endschema %}
