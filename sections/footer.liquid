{%- comment -%}
  Footer — Daily Paper layout: newsletter + link columns (collapsible on mobile),
  region/language selectors, socials, payment icons, legal line.
{%- endcomment -%}
<footer class="footer section--dark" role="contentinfo">
  <div class="page-width">
    <div class="footer__top">
      <div class="footer__brand">
        <img src="{{ 'dready-logo.png' | asset_url }}" alt="" width="72" height="72" loading="lazy" class="footer__logo">
        {%- if section.settings.tagline != blank -%}<p class="footer__tagline h3">{{ section.settings.tagline }}</p>{%- endif -%}
        {%- if section.settings.show_newsletter -%}
          <div class="footer__newsletter">
            <p class="label">{{ section.settings.newsletter_heading }}</p>
            {%- form 'customer', class: 'footer__form' -%}
              <input type="hidden" name="contact[tags]" value="newsletter">
              {%- if form.posted_successfully? -%}
                <p class="form-status form-status--success" role="status">{{ 'general.newsletter.success' | t }}</p>
              {%- else -%}
                <div class="inline-form">
                  <label for="FooterEmail" class="visually-hidden">{{ 'general.newsletter.label' | t }}</label>
                  <input id="FooterEmail" type="email" name="contact[email]" class="field__input" placeholder="{{ 'general.newsletter.label' | t }}" required autocomplete="email" {% if form.errors %}aria-invalid="true" aria-describedby="FooterEmailError"{% endif %}>
                  <button type="submit" class="btn btn--inverse" aria-label="{{ 'general.newsletter.button' | t }}">{% render 'icon', name: 'arrow-right', size: 18 %}</button>
                </div>
                {%- if form.errors -%}<p id="FooterEmailError" class="field__error">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{%- endif -%}
              {%- endif -%}
            {%- endform -%}
          </div>
        {%- endif -%}
      </div>

      <div class="footer__cols">
        {%- for block in section.blocks -%}
          {%- if block.type == 'menu' and block.settings.menu != blank -%}
            <details class="footer__col" {{ block.shopify_attributes }}>
              <summary class="footer__col-title label">{{ block.settings.heading | default: block.settings.menu.title }} {% render 'icon', name: 'plus', size: 14, class: 'footer__col-icon' %}</summary>
              <ul class="footer__links">
                {%- for link in block.settings.menu.links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}
              </ul>
            </details>
          {%- elsif block.type == 'text' -%}
            <div class="footer__col footer__col--text" {{ block.shopify_attributes }}>
              <p class="label footer__col-title">{{ block.settings.heading }}</p>
              <div class="footer__text rte">{{ block.settings.text }}</div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    <div class="footer__bottom">
      <div class="footer__left">
        {%- if section.settings.show_locale or section.settings.show_country -%}
          {% render 'footer-localization', show_country: section.settings.show_country, show_locale: section.settings.show_locale %}
        {%- endif -%}
        {% render 'social-links', size: 18 %}
      </div>
      <div class="footer__right">
        {%- if section.settings.show_payment and shop.enabled_payment_types.size > 0 -%}
          <ul class="footer__payments" aria-label="{{ 'sections.footer.payment' | t }}">
            {%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag: class: 'footer__payment-icon' }}</li>{%- endfor -%}
          </ul>
        {%- endif -%}
        <p class="footer__legal">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.legal_text }}</p>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "shopify-section-footer",
  "settings": [
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Born in Birmingham, 1983. Music, art & street culture." },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show newsletter", "default": true },
    { "type": "text", "id": "newsletter_heading", "label": "Newsletter heading", "default": "Join the community" },
    { "type": "checkbox", "id": "show_country", "label": "Show region/currency selector", "default": true },
    { "type": "checkbox", "id": "show_locale", "label": "Show language selector", "default": true },
    { "type": "checkbox", "id": "show_payment", "label": "Show payment icons", "default": true },
    { "type": "text", "id": "legal_text", "label": "Legal line", "default": "All rights reserved." }
  ],
  "blocks": [
    { "type": "menu", "name": "Link column", "settings": [ { "type": "text", "id": "heading", "label": "Heading" }, { "type": "link_list", "id": "menu", "label": "Menu" } ] },
    { "type": "text", "name": "Text column", "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "Contact" }, { "type": "richtext", "id": "text", "label": "Text", "default": "<p>info@dreadyoriginal.com</p>" } ] }
  ],
  "max_blocks": 5
}
{% endschema %}
