{%- comment -%}
  CTA band — one statement, one action. Full-bleed, oversized type, optional accent stripe.
{%- endcomment -%}
{%- assign s = section.settings -%}
<section class="section cta-band{% if s.style == 'dark' %} section--dark{% elsif s.style == 'accent' %} cta-band--accent{% endif %}">
  <div class="page-width cta-band__inner reveal">
    <div class="cta-band__text">
      {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      <h2 class="h1">{{ s.heading }}</h2>
      {%- if s.text != blank -%}<p class="body-lg cta-band__sub">{{ s.text }}</p>{%- endif -%}
    </div>
    {%- if s.button_label != blank and s.button_url != blank -%}
      <a href="{{ s.button_url }}" class="btn{% if s.style == 'dark' %} btn--inverse{% endif %}"{% if s.button_url contains '://' %} target="_blank" rel="noopener"{% endif %}>{% if s.icon != 'none' %}{% render 'icon', name: s.icon, size: 16 %}{% endif %} {{ s.button_label }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "CTA band",
  "tag": "section",
  "settings": [
    { "type": "select", "id": "style", "label": "Style", "options": [ { "value": "light", "label": "Light" }, { "value": "dark", "label": "Dark" }, { "value": "accent", "label": "Accent" } ], "default": "dark" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your call to action" },
    { "type": "text", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_url", "label": "Button link" },
    { "type": "select", "id": "icon", "label": "Button icon", "options": [ { "value": "none", "label": "None" }, { "value": "instagram", "label": "Instagram" }, { "value": "youtube", "label": "YouTube" }, { "value": "mail", "label": "Email" }, { "value": "arrow-right", "label": "Arrow" } ], "default": "none" }
  ],
  "presets": [ { "name": "CTA band" } ]
}
{% endschema %}
