<div class="password page-width">
  <div class="password__inner">
    <img src="{{ 'dready-logo.png' | asset_url }}" alt="{{ shop.name | escape }}" width="140" height="140" class="password__logo">
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h1 class="h-hero">{{ section.settings.heading }}</h1>
    {%- if section.settings.text != blank -%}<p class="body-lg password__text">{{ section.settings.text }}</p>{%- endif -%}

    {%- form 'customer', class: 'password__signup' -%}
      <input type="hidden" name="contact[tags]" value="prospect,password page">
      {%- if form.posted_successfully? -%}
        <p class="form-status form-status--success" role="status">{{ 'general.newsletter.success' | t }}</p>
      {%- else -%}
        <p class="label">{{ 'general.password_page.signup_label' | t }}</p>
        <div class="inline-form">
          <label for="PasswordEmail" class="visually-hidden">{{ 'general.newsletter.label' | t }}</label>
          <input id="PasswordEmail" type="email" name="contact[email]" class="field__input" placeholder="{{ 'general.newsletter.label' | t }}" required autocomplete="email">
          <button type="submit" class="btn btn--inverse">{{ 'general.newsletter.button' | t }}</button>
        </div>
      {%- endif -%}
    {%- endform -%}

    <details class="password__login">
      <summary class="link-underline">{% render 'icon', name: 'lock', size: 14 %} {{ 'general.password_page.login_form_heading' | t }}</summary>
      {%- form 'storefront_password', class: 'password__form' -%}
        {%- if form.errors -%}<p class="field__error" role="alert">{{ form.errors.messages.form }}</p>{%- endif -%}
        <div class="inline-form">
          <label for="Password" class="visually-hidden">{{ 'general.password_page.login_form_password_label' | t }}</label>
          <input id="Password" type="password" name="password" class="field__input" autocomplete="current-password" placeholder="{{ 'general.password_page.login_form_password_label' | t }}">
          <button type="submit" class="btn btn--inverse">{{ 'general.password_page.login_form_submit' | t }}</button>
        </div>
      {%- endform -%}
    </details>
    {% render 'social-links', size: 20 %}
  </div>
</div>
{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Dready Original" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Something's brewing" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "The new Dready store is nearly ready. Leave your email and be first through the door." }
  ]
}
{% endschema %}
