{%- comment -%} "You may also like" — uses Shopify's recommendations API via Section Rendering. {%- endcomment -%}
<div class="product-recommendations" data-product-recommendations data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}">
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <section class="section">
      <div class="page-width">
        <header class="section-header">
          <div class="section-header__text">
            <p class="eyebrow">{{ 'sections.product.related' | t }}</p>
            <h2 class="h1">{{ section.settings.heading }}</h2>
          </div>
        </header>
        <div class="grid grid--4 reveal-stagger">
          {%- for product in recommendations.products -%}
            {% render 'product-card', product: product, lazy: true %}
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}
</div>
<script>
  (() => {
    const el = document.currentScript.previousElementSibling;
    if (!el || el.querySelector('.product-card')) return;
    fetch(el.dataset.url).then(r => r.text()).then(html => {
      const tmp = document.createElement('div'); tmp.innerHTML = html;
      const inner = tmp.querySelector('[data-product-recommendations]');
      if (inner && inner.innerHTML.trim()) { el.innerHTML = inner.innerHTML; el.querySelectorAll('.reveal-stagger').forEach(x => x.classList.add('is-visible')); }
    }).catch(() => {});
  })();
</script>

{% schema %}
{
  "name": "Product recommendations",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Complete the look" },
    { "type": "range", "id": "limit", "min": 4, "max": 12, "step": 4, "label": "Products", "default": 4 }
  ]
}
{% endschema %}
