<div class="page-width account">
  <header class="page-header account__header">
    <div><p class="eyebrow">{{ customer.name }}</p><h1 class="h1">{{ 'customer.account.title' | t }}</h1></div>
    <a href="{{ routes.account_logout_url }}" class="link-underline">{{ 'customer.log_out' | t }}</a>
  </header>
  <div class="account__layout">
    <section class="account__orders">
      <h2 class="h3">{{ 'customer.account.orders' | t }}</h2>
      {%- paginate customer.orders by 10 -%}
        {%- if customer.orders.size > 0 -%}
          <table class="account__table">
            <thead><tr><th>Order</th><th>Date</th><th>Payment</th><th>Fulfillment</th><th>Total</th></tr></thead>
            <tbody>
              {%- for order in customer.orders -%}
                <tr>
                  <td><a href="{{ order.customer_url }}" class="link-underline">{{ order.name }}</a></td>
                  <td>{{ order.created_at | date: '%b %d, %Y' }}</td>
                  <td>{{ order.financial_status_label }}</td>
                  <td>{{ order.fulfillment_status_label }}</td>
                  <td>{{ order.total_price | money }}</td>
                </tr>
              {%- endfor -%}
            </tbody>
          </table>
          {%- if paginate.pages > 1 -%}{{ paginate | default_pagination }}{%- endif -%}
        {%- else -%}
          <p class="muted">{{ 'customer.account.no_orders' | t }}</p>
        {%- endif -%}
      {%- endpaginate -%}
    </section>
    <aside class="account__details">
      <h2 class="h3">{{ 'customer.account.details' | t }}</h2>
      {%- if customer.default_address -%}<address class="account__address">{{ customer.default_address | format_address }}</address>{%- endif -%}
      <a href="{{ routes.account_addresses_url }}" class="link-underline">{{ 'customer.account.view_addresses' | t }} ({{ customer.addresses_count }})</a>
    </aside>
  </div>
</div>
{% schema %}
{ "name": "Account", "settings": [] }
{% endschema %}
