<div class="page-width account account--narrow">
  <header class="page-header"><h1 class="h1">{% if template.suffix == 'activate' or request.path contains 'activate' %}{{ 'customer.activate_account.title' | t }}{% else %}{{ 'customer.reset_password.title' | t }}{% endif %}</h1></header>
  {%- if request.path contains 'activate' -%}
    {%- form 'activate_customer_password', class: 'account__form' -%}
      {%- if form.errors -%}<div class="form-status form-status--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="field"><label class="field__label" for="ActPw">{{ 'customer.reset_password.password' | t }}</label><input id="ActPw" class="field__input" type="password" name="customer[password]" autocomplete="new-password" required></div>
      <div class="field"><label class="field__label" for="ActPw2">{{ 'customer.reset_password.password_confirm' | t }}</label><input id="ActPw2" class="field__input" type="password" name="customer[password_confirmation]" autocomplete="new-password" required></div>
      <button type="submit" class="btn btn--full">{{ 'customer.activate_account.submit' | t }}</button>
      <button type="submit" name="decline" class="btn btn--outline btn--full">{{ 'customer.activate_account.cancel' | t }}</button>
    {%- endform -%}
  {%- else -%}
    {%- form 'reset_customer_password', class: 'account__form' -%}
      {%- if form.errors -%}<div class="form-status form-status--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="field"><label class="field__label" for="ResetPw">{{ 'customer.reset_password.password' | t }}</label><input id="ResetPw" class="field__input" type="password" name="customer[password]" autocomplete="new-password" required></div>
      <div class="field"><label class="field__label" for="ResetPw2">{{ 'customer.reset_password.password_confirm' | t }}</label><input id="ResetPw2" class="field__input" type="password" name="customer[password_confirmation]" autocomplete="new-password" required></div>
      <button type="submit" class="btn btn--full">{{ 'customer.reset_password.submit' | t }}</button>
    {%- endform -%}
  {%- endif -%}
</div>
{% schema %}
{ "name": "Reset / activate password", "settings": [] }
{% endschema %}
