{%- comment -%}
  Comic strip slideshow — pulls latest articles from a "Comics" blog.
  Each slide = article image + title; links to the article. Auto-rotates with
  pause/play, prev/next, dots, live region; stops on hover/focus/off-screen.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign blog = s.blog
  assign count = 0
  if blog != blank
    assign count = blog.articles.size | at_most: s.limit
  endif
-%}
<section class="section comic{% if s.dark %} section--dark{% endif %}">
  <div class="page-width">
    <header class="section-header">
      <div class="section-header__text">
        {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="h1">{{ s.heading }}</h2>{%- endif -%}
      </div>
      {%- if blog != blank -%}<a href="{{ blog.url }}" class="link-underline section-header__link">{%- if s.view_all_text != blank -%}{{ s.view_all_text }}{%- else -%}{{ 'sections.blog.all_posts' | t }}{%- endif -%}</a>{%- endif -%}
    </header>

    {%- if count > 0 -%}
      {%- assign slide_label = 'accessibility.slide_of' | t: current: '__CUR__', total: '__TOT__' | replace: '__CUR__', '{{ current }}' | replace: '__TOT__', '{{ total }}' -%}
      <div class="comic__show" data-slideshow {% if s.autoplay %}data-autoplay{% endif %} data-interval="{{ s.interval | times: 1000 }}" data-slide-label="{{ slide_label | escape }}" role="region" aria-roledescription="carousel" aria-label="{{ s.heading | escape }}" tabindex="0">
        <div class="comic__viewport">
          {%- for article in blog.articles limit: s.limit -%}
            <article class="comic__slide{% if forloop.first %} is-active{% endif %}" data-slide role="group" aria-roledescription="slide" aria-label="{{ forloop.index }} / {{ count }}">
              <a href="{{ article.url }}" class="comic__link">
                <div class="comic__media media media--wide">
                  {%- if article.image -%}
                    {{ article.image | image_url: width: 1800 | image_tag: loading: forloop.first | default: 'lazy', sizes: '(min-width: 1024px) 70vw, 100vw', widths: '600, 900, 1200, 1800', alt: article.image.alt | default: article.title | escape }}
                  {%- else -%}
                    {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                </div>
                <div class="comic__caption">
                  <span class="comic__num label">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
                  <h3 class="comic__title h3">{{ article.title }}</h3>
                  <span class="link-underline">{{ 'sections.blog.read_more' | t }}</span>
                </div>
              </a>
            </article>
          {%- endfor -%}
        </div>

        <div class="comic__controls">
          <button type="button" class="icon-btn" data-slide-prev aria-label="{{ 'accessibility.previous_slide' | t }}">{% render 'icon', name: 'arrow-left' %}</button>
          <div class="comic__dots" role="tablist">
            {%- for article in blog.articles limit: s.limit -%}
              <button type="button" class="comic__dot" data-slide-dot aria-label="{{ 'accessibility.slide_of' | t: current: forloop.index, total: count }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}"></button>
            {%- endfor -%}
          </div>
          <button type="button" class="icon-btn" data-slide-next aria-label="{{ 'accessibility.next_slide' | t }}">{% render 'icon', name: 'arrow-right' %}</button>
          <button type="button" class="icon-btn comic__toggle" data-slide-toggle data-pause-label="{{ 'accessibility.pause' | t }}" data-play-label="{{ 'accessibility.play' | t }}" aria-pressed="false">
            <span class="comic__toggle-pause">{% render 'icon', name: 'pause', size: 14 %}</span>
            <span class="comic__toggle-play">{% render 'icon', name: 'play', size: 14 %}</span>
          </button>
          <span class="visually-hidden" aria-live="polite" data-slide-live></span>
        </div>
      </div>
    {%- else -%}
      <div class="comic__show">
        <div class="comic__slide is-active"><div class="comic__media media media--wide media--placeholder" data-label="Comic strip — select a blog">{{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}</div></div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Comic strip slideshow",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Dready culture" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The comic strip" },
    { "type": "blog", "id": "blog", "label": "Blog", "info": "Create a blog called “Comics”; each strip is an article with a featured image." },
    { "type": "range", "id": "limit", "min": 2, "max": 10, "step": 1, "label": "Strips to show", "default": 5 },
    { "type": "checkbox", "id": "autoplay", "label": "Auto-rotate", "default": true },
    { "type": "range", "id": "interval", "min": 3, "max": 10, "step": 1, "unit": "s", "label": "Interval", "default": 6 },
    { "type": "text", "id": "view_all_text", "label": "View all text", "default": "Read the blog" },
    { "type": "checkbox", "id": "dark", "label": "Dark background", "default": true }
  ],
  "presets": [ { "name": "Comic strip slideshow" } ]
}
{% endschema %}
