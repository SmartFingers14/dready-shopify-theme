{%- comment -%}
  Brand story — the "Roots" chapter. Artwork on one side; wordmark, origin story, a row of
  key facts (blocks) and one CTA on the other. Roots · Culture · Peace stripe underneath.
{%- endcomment -%}
{%- assign s = section.settings -%}
<section class="section brand-story{% if s.dark %} section--dark{% endif %}">
  <div class="page-width brand-story__layout{% if s.image_side == 'right' %} brand-story__layout--flip{% endif %}">
    <div class="brand-story__art reveal">
      {%- if s.image != blank or s.asset != blank -%}
        {%- assign art_alt = s.image_alt | default: s.heading | escape -%}
        {% render 'culture-image', image: s.image, asset: s.asset, alt: art_alt, sizes: '(min-width: 1024px) 45vw, 100vw' %}
      {%- else -%}
        <div class="media media--portrait media--placeholder" data-label="Artwork">{{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
      {%- endif -%}
    </div>
    <div class="brand-story__text reveal">
      {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      {%- if s.wordmark != blank -%}
        <div class="brand-story__wordmark">{{ s.wordmark | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 1024px) 30vw, 70vw', widths: '400, 600, 900', alt: shop.name }}</div>
      {%- endif -%}
      {%- if s.heading != blank -%}<h2 class="h1 brand-story__heading">{{ s.heading }}</h2>{%- endif -%}
      {%- if s.text != blank -%}<div class="brand-story__body rte body-lg">{{ s.text }}</div>{%- endif -%}
      {%- if section.blocks.size > 0 -%}
        <dl class="brand-story__facts">
          {%- for block in section.blocks -%}
            <div class="brand-story__fact" {{ block.shopify_attributes }}>
              <dt class="brand-story__fact-value">{{ block.settings.value }}</dt>
              <dd class="brand-story__fact-label">{{ block.settings.label }}</dd>
            </div>
          {%- endfor -%}
        </dl>
      {%- endif -%}
      {%- if s.button_label != blank and s.button_url != blank -%}
        <a href="{{ s.button_url }}" class="btn{% if s.dark %} btn--inverse{% endif %} brand-story__cta">{{ s.button_label }} {% render 'icon', name: 'arrow-right', size: 14 %}</a>
      {%- endif -%}
    </div>
  </div>
  <div class="brand-story__rule" aria-hidden="true"></div>
</section>

{% schema %}
{
  "name": "Brand story",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Artwork" },
    { "type": "text", "id": "asset", "label": "Theme image file", "info": "Used when no artwork is picked above." },
    { "type": "text", "id": "image_alt", "label": "Artwork description (alt text)" },
    { "type": "select", "id": "image_side", "label": "Artwork side", "options": [ { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ], "default": "left" },
    { "type": "image_picker", "id": "wordmark", "label": "Wordmark / logo" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our roots" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Born in Birmingham, 1983" },
    { "type": "richtext", "id": "text", "label": "Story" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Read the story" },
    { "type": "url", "id": "button_url", "label": "Button link" },
    { "type": "checkbox", "id": "dark", "label": "Dark band", "default": false }
  ],
  "blocks": [
    { "type": "fact", "name": "Fact", "settings": [ { "type": "text", "id": "value", "label": "Value", "default": "1983" }, { "type": "text", "id": "label", "label": "Label", "default": "Born in Birmingham" } ] }
  ],
  "max_blocks": 4,
  "presets": [ { "name": "Brand story", "blocks": [ { "type": "fact" } ] } ]
}
{% endschema %}
